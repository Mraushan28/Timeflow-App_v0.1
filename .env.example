# TimeFlow Optional Supabase Configuration
# To enable cloud backup and multi-device sync, create a Supabase project at https://supabase.com
# Then paste your Project URL and Anon Public Key below.
# Note: TimeFlow is 100% functional locally without these.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

